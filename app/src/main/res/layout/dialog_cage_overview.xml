<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding"
    android:background="?attr/colorSurface">

    <TextView
        android:id="@+id/tvDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="@string/cage_overview"
        android:textColor="?attr/colorPrimary"
        android:textSize="@dimen/text_size_title" />

    <TextView
        android:id="@+id/tvDialogLastUpdated"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/element_spacing_small"
        android:layout_marginBottom="@dimen/element_spacing_medium"
        android:text="@string/placeholder_dash"
        android:textColor="?attr/colorOutline"
        android:textSize="@dimen/text_size_subtitle" />

    <!-- Row 1: Temperature & Humidity -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Material3.CardView.Filled"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="@dimen/element_spacing_small"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="@dimen/field_corner_radius"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="@dimen/element_spacing_medium">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/temperature_label"
                    android:textColor="?attr/colorOutline"
                    android:textSize="@dimen/text_size_helper" />

                <TextView
                    android:id="@+id/tvDialogTemperature"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/element_spacing_small"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/placeholder_dash"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/text_size_title" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Material3.CardView.Filled"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="@dimen/element_spacing_small"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="@dimen/field_corner_radius"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="@dimen/element_spacing_medium">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/humidity_label"
                    android:textColor="?attr/colorOutline"
                    android:textSize="@dimen/text_size_helper" />

                <TextView
                    android:id="@+id/tvDialogHumidity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/element_spacing_small"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/placeholder_dash"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/text_size_title" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Row 2: Air Quality & Tray Status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Material3.CardView.Filled"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="@dimen/element_spacing_small"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="@dimen/field_corner_radius"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="@dimen/element_spacing_medium">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/air_quality_label"
                    android:textColor="?attr/colorOutline"
                    android:textSize="@dimen/text_size_helper" />

                <TextView
                    android:id="@+id/tvDialogAirQuality"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/element_spacing_small"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/placeholder_dash"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/text_size_title" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Material3.CardView.Filled"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="@dimen/element_spacing_small"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="@dimen/field_corner_radius"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="@dimen/element_spacing_medium">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/tray_status_label"
                    android:textColor="?attr/colorOutline"
                    android:textSize="@dimen/text_size_helper" />

                <TextView
                    android:id="@+id/tvDialogTrayStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/element_spacing_small"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/placeholder_dash"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/text_size_title" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

</LinearLayout>