<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    tools:context=".ui.changepassword.ChangePasswordActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:title="@string/change_password_title"
        app:titleTextColor="#FFFFFF"
        app:navigationIcon="@android:drawable/ic_menu_revert" />

    <EditText
        android:id="@+id/etCurrentPassword"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_below="@id/toolbar"
        android:layout_marginTop="32dp"
        android:autofillHints="password"
        android:hint="@string/current_password"
        android:paddingStart="20dp"
        android:inputType="textPassword"
        android:background="@android:drawable/editbox_background"
        android:backgroundTint="?android:attr/colorForegroundInverse"
        android:textColor="?android:attr/textColorPrimary"
        android:textColorHint="?android:attr/textColorSecondary"
        tools:ignore="RtlSymmetry,VisualLintTextFieldSize" />

    <EditText
        android:id="@+id/etNewPassword"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_below="@id/etCurrentPassword"
        android:layout_marginTop="16dp"
        android:autofillHints="password"
        android:hint="@string/new_password"
        android:paddingStart="20dp"
        android:inputType="textPassword"
        android:background="@android:drawable/editbox_background"
        android:backgroundTint="?android:attr/colorForegroundInverse"
        android:textColor="?android:attr/textColorPrimary"
        android:textColorHint="?android:attr/textColorSecondary"
        tools:ignore="RtlSymmetry,VisualLintTextFieldSize" />

    <EditText
        android:id="@+id/etConfirmNewPassword"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_below="@id/etNewPassword"
        android:layout_marginTop="12dp"
        android:autofillHints="password"
        android:hint="@string/confirm_new_password"
        android:paddingStart="20dp"
        android:inputType="textPassword"
        android:background="@android:drawable/editbox_background"
        android:backgroundTint="?android:attr/colorForegroundInverse"
        android:textColor="?android:attr/textColorPrimary"
        android:textColorHint="?android:attr/textColorSecondary"
        tools:ignore="RtlSymmetry,VisualLintTextFieldSize" />

    <TextView
        android:id="@+id/tvChangePasswordError"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/etConfirmNewPassword"
        android:layout_marginTop="6dp"
        android:text=""
        android:textColor="#D32F2F"
        android:textSize="13sp"/>

    <Button
        android:id="@+id/btnChangePassword"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_below="@id/tvChangePasswordError"
        android:layout_marginTop="20dp"
        android:text="@string/update_password"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="?attr/colorPrimary"
        tools:ignore="VisualLintButtonSize" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/btnChangePassword"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="16dp"
        android:visibility="gone"/>

</RelativeLayout>