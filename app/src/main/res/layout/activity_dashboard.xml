<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:padding="24dp"
    tools:context=".ui.dashboard.DashboardActivity">

    <TextView
        android:id="@+id/tvAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="18sp"
        android:letterSpacing="0.1"
        android:textColor="?android:attr/colorPrimary"
        android:fontFamily="sans-serif-black"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"/>

    <TextView
        android:id="@+id/tvDeviceStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvAppName"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="8dp"
        android:text="@string/device_offline"
        android:textSize="13sp"
        android:textColor="?android:attr/textColorSecondary" />

    <TextView
        android:id="@+id/tvHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dashboard_title"
        android:textSize="28sp"
        android:textColor="?android:attr/textColorPrimary"
        android:fontFamily="sans-serif-medium"
        android:layout_below="@id/tvDeviceStatus"
        android:layout_marginTop="24dp"
        android:layout_centerHorizontal="true"/>

    <LinearLayout
        android:id="@+id/cardTemperature"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvHeader"
        android:layout_marginTop="32dp"
        android:padding="16dp"
        android:background="@android:drawable/editbox_background"
        android:backgroundTint="?android:attr/colorForegroundInverse">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/temperature_label"
            android:textSize="13sp"
            android:textColor="?android:attr/textColorSecondary" />

        <TextView
            android:id="@+id/tvTemperature"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/placeholder_dash"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/cardHumidity"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/cardTemperature"
        android:layout_marginTop="12dp"
        android:padding="16dp"
        android:background="@android:drawable/editbox_background"
        android:backgroundTint="?android:attr/colorForegroundInverse">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/humidity_label"
            android:textSize="13sp"
            android:textColor="?android:attr/textColorSecondary" />

        <TextView
            android:id="@+id/tvHumidity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/placeholder_dash"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/cardAirQuality"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/cardHumidity"
        android:layout_marginTop="12dp"
        android:padding="16dp"
        android:background="@android:drawable/editbox_background"
        android:backgroundTint="?android:attr/colorForegroundInverse">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/air_quality_label"
            android:textSize="13sp"
            android:textColor="?android:attr/textColorSecondary" />

        <TextView
            android:id="@+id/tvAirQuality"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/placeholder_dash"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/cardTrayStatus"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/cardAirQuality"
        android:layout_marginTop="12dp"
        android:padding="16dp"
        android:background="@android:drawable/editbox_background"
        android:backgroundTint="?android:attr/colorForegroundInverse">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tray_status_label"
            android:textSize="13sp"
            android:textColor="?android:attr/textColorSecondary" />

        <TextView
            android:id="@+id/tvTrayStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/placeholder_dash"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvLastUpdated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/cardTrayStatus"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="@string/placeholder_dash"
        android:textSize="12sp"
        android:textColor="?android:attr/textColorSecondary" />

    <Button
        android:id="@+id/btnLogout"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_alignParentBottom="true"
        android:text="@string/logout"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="?android:attr/colorPrimary" />

</RelativeLayout>