<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:padding="24dp"
    tools:context=".ui.forgotpassword.ForgotPasswordActivity">

    <TextView
        android:id="@+id/tvAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="18sp"
        android:letterSpacing="0.1"
        android:textColor="?android:attr/colorPrimary"
        android:fontFamily="sans-serif-black"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"/>

    <TextView
        android:id="@+id/tvHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/forgot_password_title"
        android:textSize="28sp"
        android:textColor="?android:attr/textColorPrimary"
        android:fontFamily="sans-serif-medium"
        android:layout_below="@id/tvAppName"
        android:layout_marginTop="40dp"
        android:layout_centerHorizontal="true"/>

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvHeader"
        android:layout_marginTop="12dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:gravity="center"
        android:text="@string/forgot_password_subtitle"
        android:textSize="14sp"
        android:textColor="?android:attr/textColorSecondary" />

    <EditText
        android:id="@+id/etEmail"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_below="@id/tvSubtitle"
        android:layout_marginTop="32dp"
        android:autofillHints="emailAddress"
        android:hint="@string/email"
        android:paddingStart="20dp"
        android:inputType="textEmailAddress"
        android:background="@android:drawable/editbox_background"
        android:backgroundTint="?android:attr/colorForegroundInverse"
        android:textColor="?android:attr/textColorPrimary"
        android:textColorHint="?android:attr/textColorSecondary"
        tools:ignore="RtlSymmetry,VisualLintTextFieldSize" />

    <TextView
        android:id="@+id/tvForgotPasswordError"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/etEmail"
        android:layout_marginTop="6dp"
        android:text=""
        android:textSize="13sp"
        android:visibility="visible"/>

    <Button
        android:id="@+id/btnSendReset"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_below="@id/tvForgotPasswordError"
        android:layout_marginTop="20dp"
        android:text="@string/send_reset_link"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="?android:attr/colorPrimary"
        tools:ignore="VisualLintButtonSize" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/btnSendReset"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="16dp"
        android:visibility="gone"/>

    <Button
        android:id="@+id/btnBackToLogin"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/progressBar"
        android:layout_marginTop="8dp"
        android:text="@string/back_to_login"
        android:textAllCaps="false"
        style="?android:attr/borderlessButtonStyle"
        android:textColor="?android:attr/colorPrimary"
        tools:ignore="VisualLintButtonSize" />

</RelativeLayout>