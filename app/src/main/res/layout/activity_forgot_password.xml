<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:background="?android:attr/colorBackground"
    tools:context=".ui.forgotpassword.ForgotPasswordActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_padding"
        android:paddingVertical="@dimen/screen_padding"
        tools:ignore="RtlSymmetry">

        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.08"
            android:text="@string/app_name"
            android:textColor="?attr/colorPrimary"
            android:textSize="@dimen/text_size_brand" />

        <TextView
            android:id="@+id/tvHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/element_spacing_medium"
            android:fontFamily="sans-serif-medium"
            android:text="@string/forgot_password_title"
            android:textColor="?attr/colorOnBackground"
            android:textSize="@dimen/text_size_title" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/element_spacing_small"
            android:layout_marginBottom="@dimen/element_spacing_large"
            android:text="@string/forgot_password_subtitle"
            android:textColor="?attr/colorOutline"
            android:textSize="@dimen/text_size_subtitle" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEmail"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/element_spacing_medium"
            android:hint="@string/email"
            app:boxCornerRadiusBottomEnd="@dimen/field_corner_radius"
            app:boxCornerRadiusBottomStart="@dimen/field_corner_radius"
            app:boxCornerRadiusTopEnd="@dimen/field_corner_radius"
            app:boxCornerRadiusTopStart="@dimen/field_corner_radius">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="emailAddress"
                android:inputType="textEmailAddress"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/text_size_body" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tvForgotPasswordError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/element_spacing_small"
            android:textColor="?attr/colorError"
            android:textSize="@dimen/text_size_helper"
            android:visibility="gone"
            tools:text="Error message goes here" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSendReset"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="@string/send_reset_link"
            android:textAllCaps="false"
            android:textSize="@dimen/text_size_button"
            app:cornerRadius="@dimen/field_corner_radius"
            tools:ignore="VisualLintButtonSize" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/element_spacing_small"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnBackToLogin"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/element_spacing_small"
            android:text="@string/back_to_login"
            android:textAllCaps="false"
            android:textColor="?attr/colorPrimary"
            android:textSize="@dimen/text_size_helper"
            tools:ignore="VisualLintButtonSize" />

    </LinearLayout>
</ScrollView>